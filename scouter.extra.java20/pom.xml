<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <groupId>io.github.scouter-project</groupId>
        <artifactId>scouter-parent</artifactId>
        <version>2.20.0</version> <!--scouter-->
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>scouter-extra-java20</artifactId>
    <packaging>jar</packaging>
    <name>scouter.agent.extra.java20</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.build.timestamp.format>yyyy-MM-dd HH:mm</maven.build.timestamp.format>
        <build.datetime>${maven.build.timestamp} GMT</build.datetime>
        <scouter.assembly.working.dir>${project.build.directory}/assembly-working</scouter.assembly.working.dir>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <scouter.extra.java11.jarName>scouter.weaver</scouter.extra.java11.jarName>
    </properties>

    <dependencies>

    </dependencies>
    <build>
        <plugins>
            <!-- toolchains 플러그인은 부모에 두는 걸 권장하지만,
                 모듈 단독으로도 동작하게 예시를 넣어둠 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <goals><goal>toolchain</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <!-- ~/.m2/toolchains.xml 에 등록된 21을 사용 -->
                            <version>21</version>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- JDK21 툴체인을 사용해도 -release 20 컴파일 가능 -->
                    <release>20</release>
                    <showWarnings>true</showWarnings>
                    <showDeprecation>true</showDeprecation>

                    <!-- (선택) m-c-p에서 직접 툴체인 선택도 가능 -->
                    <jdkToolchain>
                        <version>21</version>
                    </jdkToolchain>

                    <!-- fork/executable 제거! (JAVA_20_HOME 불필요) -->
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.0.2</version>
            </plugin>
        </plugins>
    </build>
</project>
